{
  "name": "penman-editor",
  "version": "0.1.0",
  "description": "A framework-agnostic, modular vanilla JavaScript rich text editor (WYSIWYG) with first-class RTL/Persian support, dark mode, and a sanitizer-first content pipeline.",
  "type": "module",
  "main": "dist/penman.umd.js",
  "module": "dist/penman.es.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/penman.es.js",
      "require": "./dist/penman.umd.js",
      "default": "./dist/penman.es.js"
    },
    "./dist/*": "./dist/*",
    "./styles/*": "./src/styles/*"
  },
  "sideEffects": [
    "*.css",
    "src/styles/*"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!src/**/*.test.js",
    "!src/**/*.spec.js",
    "!**/__tests__/**",
    "!**/__mocks__/**",
    "!**/.gitkeep",
    "!**/.DS_Store"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "server": "node server/server.js"
  },
  "author": "Fariborz J. <fariborzj2@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "editor",
    "wysiwyg",
    "rich-text",
    "rich-text-editor",
    "contenteditable",
    "vanilla-js",
    "framework-agnostic",
    "html-editor",
    "rtl",
    "persian",
    "farsi",
    "dark-mode",
    "penman"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsdom": "^29.0.2",
    "multer": "^2.1.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.4"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fariborzj2/penman.git"
  },
  "bugs": {
    "url": "https://github.com/fariborzj2/penman/issues"
  },
  "homepage": "https://github.com/fariborzj2/penman#readme",
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "codemirror": "^6.0.2"
  }
}
